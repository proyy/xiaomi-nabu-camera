+/* Nabu v4l2loopback buffers are reused by the producer. Give GStreamer
+ * camera consumers an owned frame; shared PipeWire memory can be overwritten
+ * while a downstream converter/texture upload is still using it. */
+static void
+nabu_camera_copy_frames (GstDevice *device, GstElement *element)
+{
+  GstStructure *props = gst_device_get_properties (device);
+  const gchar *card = props ? gst_structure_get_string (props, "api.v4l2.cap.card") : NULL;
+  const gchar *driver = props ? gst_structure_get_string (props, "api.v4l2.cap.driver") : NULL;
+  if (GST_IS_PIPEWIRE_SRC (element) && g_strcmp0 (driver, "v4l2 loopback") == 0 &&
+      (g_strcmp0 (card, "Pad-Front-Camera") == 0 ||
+       g_strcmp0 (card, "Pad-Rear-Camera") == 0))
+    g_object_set (element, "always-copy", TRUE, NULL);
+  if (props)
+    gst_structure_free (props);
+}
+
 static GstElement *
 gst_pipewire_device_create_element (GstDevice * device, const gchar * name)
 {
