+static int ov13b10_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13b10 *ov13b = to_ov13b10(sd);
+
+	if (is_acpi_node(dev_fwnode(dev)))
+		return 0;
+	if (of_machine_is_compatible("xiaomi,nabu")) {
+		int i;
+
+		clk_disable_unprepare(ov13b->img_clk);
+		usleep_range(1000, 1500);
+		gpiod_set_value_cansleep(ov13b->reset, 1);
+		usleep_range(1000, 1500);
+		for (i = ARRAY_SIZE(ov13b10_supply_names) - 1; i >= 0; i--)
+			regulator_disable(ov13b->supplies[i].consumer);
+		return 0;
+	}
+
+	gpiod_set_value_cansleep(ov13b->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ov13b10_supply_names), ov13b->supplies);
+	clk_disable_unprepare(ov13b->img_clk);
+	return 0;
+}
+
+static int ov13b10_get_pm_resources(struct ov13b10 *ov13b, struct device *dev)
+{
+	unsigned int i;
+	int ret;
+
+	if (is_acpi_node(dev_fwnode(dev)))
+		return 0;
+	ov13b->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov13b->reset))
+		return dev_err_probe(dev, PTR_ERR(ov13b->reset), "failed to get reset GPIO\n");
+	ov13b->img_clk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov13b->img_clk))
+		return dev_err_probe(dev, PTR_ERR(ov13b->img_clk), "failed to get sensor clock\n");
+	ret = clk_set_rate(ov13b->img_clk, OV13B10_EXT_CLK);
+	if (ret)
+		return ret;
+	if (clk_get_rate(ov13b->img_clk) != OV13B10_EXT_CLK)
+		return dev_err_probe(dev, -EINVAL, "sensor clock must be 19.2 MHz\n");
+	for (i = 0; i < ARRAY_SIZE(ov13b10_supply_names); i++)
+		ov13b->supplies[i].supply = ov13b10_supply_names[i];
+	return devm_regulator_bulk_get(dev, ARRAY_SIZE(ov13b10_supply_names), ov13b->supplies);
+}
