@@ -340,10 +340,12 @@ int DebayerEGL::configure(const StreamConfiguration &inputCfg,
 	window_.height = outputCfg.size.height;
 
 	/*
-	 * Don't pass x,y from window_ since process() already adjusts for it.
-	 * But crop the window to 2/3 of its width and height for speedup.
+	 * GPU output scaling doesn't crop or offset the RAW buffer passed to
+	 * processFrame(). Statistics therefore need input dimensions. Using the
+	 * smaller RGB dimensions here meters only the upper-left RAW quadrant
+	 * for a half-size output, even though the RGB image shows the full view.
 	 */
-	stats_->setWindow(Rectangle(window_.size()));
+	stats_->setWindow(Rectangle(inputCfg.size));
 
 	inputBufferCount_ = inputCfg.bufferCount;
 	outputBufferCount_ = outputCfg.bufferCount;
